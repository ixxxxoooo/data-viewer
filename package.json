{
  "name": "excel-csv-viewer",
  "displayName": "Excel & CSV Data Viewer",
  "description": "High-performance Excel & CSV data viewer with virtual scrolling, filtering, sorting and cell editing",
  "version": "0.1.0",
  "publisher": "ixxxxoooo",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ixxxxoooo/data-viewer"
  },
  "homepage": "https://github.com/ixxxxoooo/data-viewer#readme",
  "bugs": {
    "url": "https://github.com/ixxxxoooo/data-viewer/issues"
  },
  "keywords": [
    "csv",
    "tsv",
    "excel",
    "xlsx",
    "xls",
    "data",
    "viewer",
    "table",
    "grid",
    "spreadsheet",
    "editor"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Data Science",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "dataViewer.csvEditor",
        "displayName": "Excel & CSV Data Viewer",
        "selector": [
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "dataViewer.excelEditor",
        "displayName": "Excel & CSV Data Viewer",
        "selector": [
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.xls"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.11.0",
    "@types/papaparse": "^5.5.2",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.21.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "ag-grid-community": "^32.0.0",
    "papaparse": "^5.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
